PORT=3000
HOST=127.0.0.1
LOG_DIR=./logs
MAX_INDEX_SIZE=10000
NODE_ENV=development

# Optional API key for authentication (leave unset for open access)
# API_KEY=your-secret-key-here

# NexVill S3 archive viewer (optional; unset = local JSON files)
# LOGS_S3_BUCKET=nexvill-logs-euc1
# LOGS_S3_REGION=eu-central-1
# LOGS_S3_ACCESS_KEY_ID=
# LOGS_S3_SECRET_ACCESS_KEY=
# LOGS_S3_ENDPOINT=
# LOGS_S3_DEFAULT_ENV=dev
# LOGS_S3_DEFAULT_SERVICE=nexvill-api
# LOGS_S3_INCLUDE_LANDING=true
# LOGS_S3_MAX_HOURS=168
